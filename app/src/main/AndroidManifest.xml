<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet is required for Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ChalkMessageApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChalkMessage">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ChalkMessage">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCM Service: listens for push notifications even when app is closed -->
        <service
            android:name=".service.ChalkMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Widget Provider: tells Android we have a home screen widget -->
        <receiver
            android:name=".widget.ChalkWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/chalk_widget_info" />
        </receiver>

    </application>
</manifest>
